<?xml version='1.0' encoding='utf-8'?>
<nta>
<declaration>
bool coating_done = false;
bool curing_zone_active = false;
</declaration><template><name>CoatingRobot</name><declaration>clock x;</declaration><location id="id0" x="0" y="0"><name x="-15" y="-30">Idle</name><urgent /></location><location id="id1" x="220" y="0"><name x="180" y="-30">CoatCell</name><label kind="invariant" x="190" y="25">x &lt;= 4</label></location><location id="id2" x="440" y="0"><name x="185" y="-30">CuringZone</name><label kind="invariant" x="410" y="25">x &lt;= 3</label></location><location id="id3" x="660" y="0"><name x="640" y="-30">Done</name></location><init ref="id0" /><transition><source ref="id0" /><target ref="id1" /><label kind="assignment" x="75" y="-20">x = 0</label></transition><transition><source ref="id1" /><target ref="id2" /><label kind="guard" x="275" y="-35">x &gt;= 2 &amp;&amp; !curing_zone_active</label><label kind="assignment" x="205" y="15">x = 0, coating_done = true, curing_zone_active = true</label></transition><transition><source ref="id2" /><target ref="id3" /><label kind="guard" x="495" y="-35">x &gt;= 1</label><label kind="assignment" x="470" y="15">curing_zone_active = false</label></transition></template><template><name>TransportAMR</name><declaration>clock y;</declaration><location id="id10" x="0" y="220"><name x="-15" y="190">Idle</name><urgent /></location><location id="id11" x="220" y="220"><name x="180" y="190">PickupCell</name><label kind="invariant" x="190" y="245">y &lt;= 2</label></location><location id="id12" x="440" y="220"><name x="180" y="190">CuringZone</name><label kind="invariant" x="410" y="245">y &lt;= 3</label></location><init ref="id10" /><transition><source ref="id10" /><target ref="id11" /><label kind="guard" x="75" y="205">!coating_done</label><label kind="assignment" x="75" y="205">y = 0</label></transition><transition><source ref="id11" /><target ref="id12" /><label kind="guard" x="275" y="185">y &gt;= 1 &amp;&amp; coating_done &amp;&amp; !curing_zone_active</label><label kind="assignment" x="270" y="235">y = 0</label></transition></template><system>
coater = CoatingRobot();
transport = TransportAMR();
system coater, transport;
</system><queries><query><formula>A[] (transport.PickupCell imply coating_done)</formula><comment /></query><query><formula>A[] not (coater.CuringZone &amp;&amp; transport.CuringZone)</formula><comment /></query><query><formula>E&lt;&gt; coater.Done</formula><comment /></query><query><formula>E&lt;&gt; transport.CuringZone</formula><comment /></query></queries></nta>