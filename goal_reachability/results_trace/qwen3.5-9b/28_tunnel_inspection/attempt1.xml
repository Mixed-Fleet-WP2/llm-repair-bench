<?xml version='1.0' encoding='utf-8'?>
<nta>
<declaration>
bool tunnel_map_done = false;
bool narrow_section_busy = false;
</declaration><template><name>MappingUGV</name><declaration>clock x;</declaration><location id="id0" x="0" y="0"><name x="-15" y="-30">Idle</name><urgent /></location><location id="id1" x="220" y="0"><name x="170" y="-30">NarrowSection</name><label kind="invariant" x="190" y="25">x &lt;= 4</label></location><location id="id2" x="440" y="0"><name x="390" y="-30">MapComplete</name></location><init ref="id0" /><transition><source ref="id0" /><target ref="id1" /><label kind="assignment" x="45" y="-20">x = 0, narrow_section_busy = true</label></transition><transition><source ref="id1" /><target ref="id2" /><label kind="guard" x="275" y="-35">x &gt;= 2</label><label kind="assignment" x="190" y="15">tunnel_map_done = true, narrow_section_busy = false</label></transition></template><template><name>RepairUGV</name><declaration>clock y;</declaration><location id="id10" x="0" y="220"><name x="-15" y="190">Idle</name><urgent /></location><location id="id11" x="220" y="220"><name x="170" y="190">NarrowSection</name><label kind="invariant" x="190" y="245">y &lt;= 2</label></location><location id="id12" x="440" y="220"><name x="410" y="190">Repair</name></location><init ref="id10" /><transition><source ref="id10" /><target ref="id11" /><label kind="assignment" x="75" y="205">y = 0</label></transition><transition><source ref="id11" /><target ref="id12" /><label kind="guard" x="275" y="185">y &gt;= 1 AND tunnel_map_done</label><label kind="assignment" x="190" y="15">narrow_section_busy = false</label></transition></template><system>
mapper = MappingUGV();
repair = RepairUGV();
system mapper, repair;
</system><queries><query><formula>A[] not (mapper.NarrowSection &amp;&amp; repair.NarrowSection)</formula><comment /></query><query><formula>A[] (repair.Repair imply tunnel_map_done)</formula><comment /></query><query><formula>E&lt;&gt; mapper.MapComplete</formula><comment /></query><query><formula>E&lt;&gt; repair.Repair</formula><comment /></query></queries></nta>