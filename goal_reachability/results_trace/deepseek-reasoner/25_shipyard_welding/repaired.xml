<nta>
<declaration>
bool weld_zone_hot = false;
bool inspection_in_weld_zone = false;
</declaration><template><name>WeldingRobot</name><declaration>clock x;</declaration><location id="id0" x="0" y="0"><name x="-15" y="-30">Idle</name></location><location id="id1" x="220" y="0"><name x="185" y="-30">WeldJoint</name><label kind="invariant" x="190" y="25">x &lt;= 5</label></location><location id="id2" x="440" y="0"><name x="385" y="-30">CoolingZone</name><label kind="invariant" x="410" y="25">x &lt;= 3</label></location><init ref="id0" /><transition><source ref="id0" /><target ref="id1" /><label kind="guard" x="45" y="-35">!inspection_in_weld_zone</label><label kind="assignment" x="45" y="-20">x = 0, weld_zone_hot = true</label></transition><transition><source ref="id1" /><target ref="id2" /><label kind="guard" x="275" y="-35">x &gt;= 3</label><label kind="assignment" x="270" y="15">x = 0, weld_zone_hot = false</label></transition></template><template><name>InspectionAMR</name><declaration>clock t;</declaration><location id="id10" x="0" y="220"><name x="-15" y="190">Idle</name></location><location id="id11" x="220" y="220"><name x="180" y="190">WeldZone</name><label kind="invariant" x="190" y="245">t &lt;= 4</label></location><location id="id12" x="440" y="220"><name x="400" y="190">InspectJoint</name><label kind="invariant" x="410" y="245">t &lt;= 3</label></location><init ref="id10" /><transition><source ref="id10" /><target ref="id11" /><label kind="guard" x="75" y="205">!weld_zone_hot</label><label kind="assignment" x="75" y="220">t = 0, inspection_in_weld_zone = true</label></transition><transition><source ref="id11" /><target ref="id12" /><label kind="guard" x="275" y="185">t &gt;= 4</label><label kind="assignment" x="270" y="235">t = 0, inspection_in_weld_zone = false</label></transition></template><system>
welder = WeldingRobot();
inspection = InspectionAMR();
system welder, inspection;
</system><queries><query><formula>A[] not (welder.WeldJoint &amp;&amp; inspection.WeldZone)</formula><comment /></query><query><formula>A[] (inspection.WeldZone imply inspection.t &lt;= 4)</formula><comment /></query><query><formula>E&lt;&gt; welder.CoolingZone</formula><comment /></query><query><formula>E&lt;&gt; inspection.InspectJoint</formula><comment /></query></queries></nta>