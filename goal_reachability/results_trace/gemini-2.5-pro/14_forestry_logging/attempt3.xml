</system><queries><query><formula>A[] not (feller.CutTree &amp;&amp; hauler.CutZone)</formula><comment /></query><query><formula>feller.TreeFelled --&gt; hauler.Collect</formula><comment /></query><query><formula>E&lt;&gt; feller.TreeFelled</formula><comment /></query><query><formula>E&lt;&gt; hauler.Collect</formula><comment /></query></queries></nta>