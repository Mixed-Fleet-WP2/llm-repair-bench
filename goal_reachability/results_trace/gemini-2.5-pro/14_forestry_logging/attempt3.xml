<nta>
<declaration>
bool tree_felled = false;
bool cutting_zone_busy = false;
</declaration><template><name>FellerRobot</name><declaration>clock x;</declaration><location id="id0" x="0" y="0"><name x="-15" y="-30">Idle</name><urgent /></location><location id="id1" x="220" y="0"><name x="195" y="-30">CutTree</name><label kind="invariant" x="190" y="25">x &lt;= 5</label></location><location id="id2" x="440" y="0"><name x="385" y="-30">TreeFelled</name></location><init ref="id0" /><transition><source ref="id0" /><target ref="id1" /><label kind="guard" x="45" y="-45">!cutting_zone_busy</label><label kind="assignment" x="45" y="-20">x = 0, cutting_zone_busy = true</label></transition><transition><source ref="id1" /><target ref="id2" /><label kind="guard" x="275" y="-35">x &gt;= 3</label><label kind="assignment" x="210" y="15">tree_felled = true, cutting_zone_busy = false</label></transition></template><template><name>HaulRobot</name><declaration>clock y;</declaration><location id="id10" x="0" y="220"><name x="-15" y="190">Idle</name><urgent /></location><location id="id11" x="220" y="220"><name x="190" y="190">CutZone</name><label kind="invariant" x="190" y="245">y &lt;= 2</label></location><location id="id12" x="440" y="220"><name x="405" y="190">Decision</name><urgent /></location><location id="id13" x="660" y="165"><name x="635" y="135">Collect</name><label kind="invariant" x="630" y="190">y &lt;= 3</label></location><location id="id14" x="660" y="300"><name x="635" y="270">Wait</name><label kind="invariant" x="630" y="325">y &lt;= 2</label></location><init ref="id10" /><transition><source ref="id10" /><target ref="id11" /><label kind="guard" x="55" y="190">!cutting_zone_busy</label><label kind="assignment" x="75" y="205">y = 0, cutting_zone_busy = true</label></transition><transition><source ref="id11" /><target ref="id12" /><label kind="guard" x="275" y="185">y &gt;= 1</label><label kind="assignment" x="275" y="205">cutting_zone_busy = false</label></transition><transition><source ref="id12" /><target ref="id13" /><label kind="guard" x="495" y="140">tree_felled</label><label kind="assignment" x="500" y="170">y = 0</label></transition><transition><source ref="id12" /><target ref="id14" /><label kind="guard" x="495" y="260">!tree_felled</label><label kind="assignment" x="500" y="285">y = 0</label></transition><transition><source ref="id14" /><target ref="id12" /><label kind="guard" x="555" y="345">y &gt;= 1</label></transition></template><system>
