<?xml version='1.0' encoding='utf-8'?>
<nta>
<declaration>
bool cargo_loaded = false;
bool crane_swing_done = false;
</declaration><template><name>CraneBot</name><declaration>clock x;</declaration><location id="id0" x="0" y="0"><name x="-20" y="-30">Idle</name></location><location id="id1" x="220" y="0"><name x="200" y="-30">Lift</name><label kind="invariant" x="190" y="25">x &lt;= 3</label></location><location id="id2" x="440" y="0"><name x="420" y="-30">Swing</name><label kind="invariant" x="410" y="25">x &lt;= 4</label></location><location id="id3" x="660" y="0"><name x="640" y="-30">Place</name><label kind="invariant" x="630" y="25">x &lt;= 2</label></location><location id="id4" x="880" y="0"><name x="860" y="-30">Done</name></location><init ref="id0" /><transition><source ref="id0" /><target ref="id1" /><label kind="assignment" x="75" y="25">x = 0</label></transition><transition><source ref="id1" /><target ref="id2" /><label kind="guard" x="275" y="-25">x &gt;= 1</label><label kind="assignment" x="275" y="25">x = 0</label></transition><transition><source ref="id2" /><target ref="id3" /><label kind="guard" x="495" y="-25">x &gt;= 2</label><label kind="assignment" x="495" y="25">x = 0, crane_swing_done = true</label></transition><transition><source ref="id3" /><target ref="id4" /><label kind="guard" x="715" y="-25">x &gt;= 1</label><label kind="assignment" x="715" y="25">cargo_loaded = true</label></transition></template><template><name>TransportAGV</name><declaration>clock y;</declaration><location id="id10" x="0" y="220"><name x="-20" y="190">Idle</name></location><location id="id11" x="220" y="220"><name x="200" y="190">Approach</name><label kind="invariant" x="190" y="245">y &lt;= 2</label></location><location id="id12" x="440" y="220"><name x="420" y="190">LoadZone</name><label kind="invariant" x="410" y="245">y &lt;= 2</label></location><location id="id13" x="660" y="220"><name x="640" y="190">Depart</name><label kind="invariant" x="630" y="245">y &lt;= 2</label></location><location id="id14" x="880" y="220"><name x="860" y="190">Done</name></location><init ref="id10" /><transition><source ref="id10" /><target ref="id11" /><label kind="assignment" x="75" y="245">y = 0</label></transition><transition><source ref="id11" /><target ref="id12" /><label kind="guard" x="275" y="195">y &gt;= 1 &amp;&amp; crane_swing_done</label><label kind="assignment" x="275" y="245">y = 0</label></transition><transition><source ref="id12" /><target ref="id13" /><label kind="guard" x="495" y="195">y &gt;= 1</label><label kind="assignment" x="495" y="245">y = 0</label></transition><transition><source ref="id13" /><target ref="id14" /><label kind="guard" x="715" y="195">y &gt;= 1</label></transition></template><system>
crane = CraneBot();
agv = TransportAGV();
system crane, agv;
</system><queries><query><formula>A[] not (crane.Swing &amp;&amp; agv.LoadZone)</formula><comment /></query><query><formula>A[] (agv.Depart imply cargo_loaded)</formula><comment /></query><query><formula>E&lt;&gt; crane.Done</formula><comment /></query><query><formula>E&lt;&gt; agv.Done</formula><comment /></query></queries></nta>