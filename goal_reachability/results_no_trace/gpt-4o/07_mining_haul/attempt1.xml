</declaration><template><name>DrillBot</name><declaration>clock x;</declaration><location id="id0" x="0" y="0"><name x="-15" y="-30">Idle</name><urgent /></location><location id="id1" x="220" y="0"><name x="195" y="-30">Drill</name><label kind="invariant" x="190" y="25">x &lt;= 5</label></location><location id="id2" x="440" y="0"><name x="420" y="-30">Done</name></location><init ref="id0" /><transition><source ref="id0" /><target ref="id1" /><label kind="assignment" x="55" y="-20">x = 0, drilling_active = true</label></transition><transition><source ref="id1" /><target ref="id2" /><label kind="guard" x="275" y="-35">x &gt;= 3</label><label kind="assignment" x="255" y="15">drilling_active = false</label></transition></template><template><name>HaulerBot</name><declaration>clock y;</declaration><location id="id10" x="0" y="220"><name x="-15" y="190">Idle</name><urgent /></location><location id="id11" x="220" y="220"><name x="190" y="190">Tunnel</name><label kind="invariant" x="190" y="245">y &lt;= 2</label></location><location id="id12" x="440" y="220"><name x="410" y="190">Loading</name><label kind="invariant" x="410" y="245">y &lt;= 2</label></location><location id="id13" x="660" y="220"><name x="625" y="190">Transport</name><label kind="invariant" x="630" y="245">y &lt;= 3</label></location><location id="id14" x="880" y="220"><name x="860" y="190">Done</name></location><init ref="id10" /><transition><source ref="id10" /><target ref="id11" /><label kind="guard" x="80" y="225">!drilling_active</label><label kind="assignment" x="75" y="205">y = 0</label></transition><transition><source ref="id11" /><target ref="id12" /><label kind="guard" x="275" y="185">y &gt;= 1</label><label kind="assignment" x="265" y="235">y = 0, load_weight = max(12, MAX_LOAD)</label></transition><transition><source ref="id12" /><target ref="id13" /><label kind="guard" x="495" y="185">y &gt;= 1</label><label kind="assignment" x="490" y="235">y = 0</label></transition><transition><source ref="id13" /><target ref="id14" /><label kind="guard" x="715" y="185">y &gt;= 1</label></transition></template><system>
drill = DrillBot();
hauler = HaulerBot();
