</system><queries><query><formula>A[] not (drill.Drill &amp;&amp; hauler.Tunnel)</formula><comment /></query><query><formula>A[] (hauler.Transport imply load_weight &lt;= MAX_LOAD)</formula><comment /></query><query><formula>E&lt;&gt; drill.Done</formula><comment /></query><query><formula>E&lt;&gt; hauler.Done</formula><comment /></query></queries></nta>