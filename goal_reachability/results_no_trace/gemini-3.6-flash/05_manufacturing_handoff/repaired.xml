<?xml version='1.0' encoding='utf-8'?>
<nta>
<declaration>
bool welding_active = true;
bool handoff_done = false;
</declaration><template><name>ArmBot</name><declaration>clock x;</declaration><location id="id0" x="0" y="0"><name x="-20" y="-30">Weld</name><label kind="invariant" x="-30" y="25">x &lt;= 4</label></location><location id="id1" x="260" y="0"><name x="240" y="-30">Handoff</name><label kind="invariant" x="230" y="25">x &lt;= 2</label></location><location id="id2" x="520" y="0"><name x="500" y="-30">HandoffDone</name></location><init ref="id0" /><transition><source ref="id0" /><target ref="id1" /><label kind="guard" x="110" y="-25">x &gt;= 2</label><label kind="assignment" x="110" y="25">x = 0, welding_active = false</label></transition><transition><source ref="id1" /><target ref="id2" /><label kind="guard" x="370" y="-25">x &gt;= 1</label><label kind="assignment" x="370" y="25">handoff_done = true</label></transition></template><template><name>MobileRobot</name><declaration>clock y;</declaration><location id="id10" x="0" y="240"><name x="-20" y="210">Idle</name><label kind="invariant" x="-30" y="265">y &lt;= 6</label></location><location id="id11" x="240" y="240"><name x="220" y="210">LoadZone</name><label kind="invariant" x="210" y="265">y &lt;= 2</label></location><location id="id12" x="480" y="240"><name x="460" y="210">Decision</name><urgent /></location><location id="id13" x="720" y="170"><name x="700" y="140">Deliver</name><label kind="invariant" x="690" y="195">y &lt;= 3</label></location><location id="id14" x="720" y="310"><name x="700" y="280">Standby</name><label kind="invariant" x="690" y="335">y &lt;= 2</label></location><location id="id15" x="960" y="170"><name x="940" y="140">Done</name></location><init ref="id10" /><transition><source ref="id10" /><target ref="id11" /><label kind="guard" x="90" y="240">!welding_active</label><label kind="assignment" x="90" y="265">y = 0</label></transition><transition><source ref="id11" /><target ref="id12" /><label kind="guard" x="330" y="215">y &gt;= 1</label></transition><transition><source ref="id12" /><target ref="id13" /><label kind="guard" x="560" y="165">handoff_done</label><label kind="assignment" x="560" y="215">y = 0</label></transition><transition><source ref="id12" /><target ref="id14" /><label kind="guard" x="560" y="300">!handoff_done</label><label kind="assignment" x="560" y="325">y = 0</label></transition><transition><source ref="id14" /><target ref="id12" /><label kind="guard" x="610" y="330">y &gt;= 1</label></transition><transition><source ref="id13" /><target ref="id15" /><label kind="guard" x="820" y="145">y &gt;= 1</label></transition></template><system>
arm = ArmBot();
mobile = MobileRobot();
system arm, mobile;
</system><queries><query><formula>A[] not (arm.Weld &amp;&amp; mobile.LoadZone)</formula><comment /></query><query><formula>arm.HandoffDone --&gt; mobile.Deliver</formula><comment /></query><query><formula>E&lt;&gt; arm.HandoffDone</formula><comment /></query><query><formula>E&lt;&gt; mobile.Done</formula><comment /></query></queries></nta>