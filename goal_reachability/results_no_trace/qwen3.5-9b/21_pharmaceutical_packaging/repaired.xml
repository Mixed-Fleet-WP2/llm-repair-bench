<?xml version='1.0' encoding='utf-8'?>
<nta>
<declaration>
bool quality_checked = false;
bool sterile_zone_ready = false;
</declaration><template><name>InspectionArm</name><declaration>clock x;</declaration><location id="id0" x="0" y="0"><name x="-15" y="-30">Idle</name><urgent /></location><location id="id1" x="220" y="0"><name x="180" y="-30">QualityCheck</name><label kind="invariant" x="190" y="25">x &lt;= 4</label></location><location id="id2" x="440" y="0"><name x="390" y="-30">CheckComplete</name></location><init ref="id0" /><transition><source ref="id0" /><target ref="id1" /><label kind="assignment" x="75" y="-20">x = 0</label></transition><transition><source ref="id1" /><target ref="id2" /><label kind="guard" x="275" y="-35">x &gt;= 2</label><label kind="assignment" x="195" y="15">quality_checked = true</label></transition></template><template><name>PackingAMR</name><declaration>clock y;</declaration><location id="id10" x="0" y="220"><name x="-15" y="190">Idle</name><urgent /></location><location id="id11" x="220" y="220"><name x="185" y="190">PickBatch</name><label kind="invariant" x="190" y="245">y &lt;= 2</label></location><location id="id12" x="440" y="220"><name x="390" y="190">EnterSterileZone</name><label kind="invariant" x="410" y="245">y &lt;= 3</label></location><location id="id13" x="660" y="220"><name x="635" y="190">Pack</name></location><init ref="id10" /><transition><source ref="id10" /><target ref="id11" /><label kind="assignment" x="75" y="205">y = 0</label></transition><transition><source ref="id11" /><target ref="id12" /><label kind="guard" x="275" y="185">y &gt;= 1</label><label kind="assignment" x="270" y="235">y = 0</label></transition><transition><source ref="id12" /><target ref="id13" /><label kind="guard" x="495" y="185">y &gt;= 1</label><label kind="assignment" x="525" y="235">sterile_zone_ready = true</label></transition></template><system>
inspection = InspectionArm();
packing = PackingAMR();
system inspection, packing;
</system><queries><query><formula>A[] (packing.PickBatch imply quality_checked)</formula><comment /></query><query><formula>A[] (packing.EnterSterileZone imply sterile_zone_ready)</formula><comment /></query><query><formula>E&lt;&gt; inspection.CheckComplete</formula><comment /></query><query><formula>E&lt;&gt; packing.Pack</formula><comment /></query></queries></nta>