<?xml version='1.0' encoding='utf-8'?>
<nta>
<declaration>
bool map_done = false;
bool hazard_active = true;
</declaration><template><name>SurveyDrone</name><declaration>clock x;</declaration><location id="id0" x="0" y="0"><name x="-15" y="-30">Idle</name><urgent /></location><location id="id1" x="220" y="0"><name x="195" y="-30">MapZone</name><label kind="invariant" x="190" y="25">x &lt;= 5</label></location><location id="id2" x="440" y="0"><name x="410" y="-30">Done</name></location><init ref="id0" /><transition><source ref="id0" /><target ref="id1" /><label kind="assignment" x="75" y="-20">x = 0</label></transition><transition><source ref="id1" /><target ref="id2" /><label kind="guard" x="275" y="-35">x &gt;= 3</label><label kind="assignment" x="245" y="15">map_done = true, hazard_active = false</label></transition></template><template><name>RescueUGV</name><declaration>clock y;</declaration><location id="id10" x="0" y="220"><name x="-15" y="190">Idle</name><urgent /></location><location id="id11" x="220" y="220"><name x="185" y="190">EnterZone</name><label kind="invariant" x="190" y="245">y &lt;= 2</label></location><location id="id12" x="440" y="220"><name x="420" y="190">Search</name><label kind="invariant" x="410" y="245">y &lt;= 3</label></location><location id="id13" x="660" y="220"><name x="640" y="190">Done</name></location><init ref="id10" /><transition><source ref="id10" /><target ref="id11" /><label kind="guard" x="75" y="205">map_done</label><label kind="assignment" x="75" y="220">y = 0</label></transition><transition><source ref="id11" /><target ref="id12" /><label kind="guard" x="275" y="185">y &gt;= 1</label><label kind="assignment" x="270" y="235">y = 0</label></transition><transition><source ref="id12" /><target ref="id13" /><label kind="guard" x="495" y="185">y &gt;= 1 &amp;&amp; !hazard_active</label></transition></template><system>
drone = SurveyDrone();
ugv = RescueUGV();
system drone, ugv;
</system><queries><query><formula>A[] (ugv.EnterZone imply map_done)</formula><comment /></query><query><formula>A[] (ugv.Search imply !hazard_active)</formula><comment /></query><query><formula>E&lt;&gt; drone.Done</formula><comment /></query><query><formula>E&lt;&gt; ugv.Done</formula><comment /></query></queries></nta>