<?xml version='1.0' encoding='utf-8'?>
<nta>
<declaration>
bool sample_prepared = false;
bool chamber_clean = false;
</declaration><template><name>PrepRobot</name><declaration>clock x;</declaration><location id="id0" x="0" y="0"><name x="-15" y="-30">Idle</name><urgent /></location><location id="id1" x="220" y="0"><name x="180" y="-30">PrepareSample</name><label kind="invariant" x="190" y="25">x &lt;= 4</label></location><location id="id2" x="440" y="0"><name x="400" y="-30">CleanChamber</name><label kind="invariant" x="410" y="25">x &lt;= 3</label></location><location id="id3" x="660" y="0"><name x="640" y="-30">Done</name></location><init ref="id0" /><transition><source ref="id0" /><target ref="id1" /><label kind="assignment" x="75" y="-20">x = 0</label></transition><transition><source ref="id1" /><target ref="id2" /><label kind="guard" x="275" y="-35">x &gt;= 2</label><label kind="assignment" x="225" y="15">x = 0, sample_prepared = true</label></transition><transition><source ref="id2" /><target ref="id3" /><label kind="guard" x="495" y="-35">x &gt;= 1</label><label kind="assignment" x="465" y="15">chamber_clean = true</label></transition></template><template><name>AnalysisRobot</name><declaration>clock y;</declaration><location id="id10" x="0" y="220"><name x="-15" y="190">Idle</name><urgent /></location><location id="id11" x="220" y="220"><name x="190" y="190">LoadSample</name><label kind="invariant" x="190" y="245">y &lt;= 2</label></location><location id="id12" x="440" y="220"><name x="410" y="190">Analyze</name><label kind="invariant" x="410" y="245">y &lt;= 4</label></location><init ref="id10" /><transition><source ref="id10" /><target ref="id11" /><label kind="assignment" x="75" y="205">y = 0</label></transition><transition><source ref="id11" /><target ref="id12" /><label kind="guard" x="275" y="185">y &gt;= 1</label></transition></template><system>
prep = PrepRobot();
analysis = AnalysisRobot();
system prep, analysis;
</system><queries><query><formula>A[] (analysis.LoadSample imply sample_prepared)</formula><comment /></query><query><formula>A[] (analysis.Analyze imply chamber_clean)</formula><comment /></query><query><formula>E&lt;&gt; prep.Done</formula><comment /></query><query><formula>E&lt;&gt; analysis.Analyze</formula><comment /></query></queries></nta>